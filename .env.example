# =============================================================================
# Congrega — configuração da instalação self-hosted
# =============================================================================
#
# Copie para `.env`, preencha e suba com `docker compose up -d`.
#
#   cp .env.example .env
#
# ⚠️  O `.env` NUNCA vai para o Git. Ele é a chave da casa: contém a senha do
#     banco, o segredo que assina os tokens de sessão e as duas chaves sem as
#     quais os dados cifrados viram bytes ilegíveis.
#
# -----------------------------------------------------------------------------
# COMO O .NET LÊ ESTAS VARIÁVEIS
# -----------------------------------------------------------------------------
#
# O separador de seção é DOIS SUBLINHADOS, não dois-pontos:
#
#     appsettings.json          variável de ambiente
#     Database:PooledConn...    Database__PooledConnectionString
#
# Dois-pontos funciona no Linux e NÃO funciona em contêiner Windows nem em
# vários orquestradores. Dois sublinhados funciona em todos. É a causa número um
# de "configurei e a aplicação não vê" — se algo aqui parecer ignorado, é o
# primeiro lugar a olhar.
#
# Variável de ambiente VENCE o `appsettings.json`. Nada aqui precisa ser editado
# dentro da imagem.


# =============================================================================
# 1. BANCO DE DADOS  — obrigatório
# =============================================================================
#
# O banco é SEU. Os dados dos seus membros, o financeiro e a agenda nunca saem
# deste servidor: a Congrega não tem acesso, não faz cópia e não consegue ler.
#
# Aponte para o Postgres que você administra. Se estiver usando o Postgres do
# `docker-compose.yml` que acompanha o projeto, o host é o nome do serviço
# (`postgres`), não `localhost` — dentro da rede do Docker, `localhost` é o
# próprio contêiner da API.

POSTGRES_PASSWORD=troque-esta-senha

Database__PooledConnectionString=Host=postgres;Port=5432;Database=congrega;Username=congrega_app;Password=troque-esta-senha
#
# A conexão DIRETA existe por um motivo específico: o worker usa lock de sessão
# do Postgres (`pg_advisory_lock`), e lock de sessão não sobrevive a um pooler em
# modo transaction. Sem pooler no meio, as duas apontam para o mesmo lugar.
Database__DirectConnectionString=Host=postgres;Port=5432;Database=congrega;Username=congrega_app;Password=troque-esta-senha


# =============================================================================
# 2. SEGREDOS DA APLICAÇÃO  — obrigatório, GERE OS SEUS
# =============================================================================
#
# ⚠️  NÃO copie os valores de nenhum tutorial, print ou repositório. Um segredo
#     que outra pessoa conhece não é um segredo — e o de assinatura de token
#     permite a quem o tiver entrar como qualquer pessoa da sua igreja.
#
# Gere assim (Linux/macOS/WSL):
#
#     openssl genrsa -out chave.pem 2048          # Authentication__SigningKeyPem
#     openssl rand -base64 32                     # as chaves AES
#     openssl rand -base64 48                     # os peppers
#
# A aplicação NÃO SOBE sem estes valores. É deliberado: subir com a cifragem
# desligada gravaria ficha médica de criança em texto claro sem nada acusar.

Authentication__Issuer=https://congrega.suaigreja.com.br
Authentication__Audience=congrega-app

# Chave RSA em PEM, numa linha só — troque as quebras de linha por \n literais:
#     awk 'BEGIN{ORS="\\n"} {print}' chave.pem
Authentication__SigningKeyPem=-----BEGIN PRIVATE KEY-----\nCOLE_AQUI\n-----END PRIVATE KEY-----

# Tempera do hash dos códigos de acesso por e-mail (mínimo 32 caracteres).
Authentication__OtpPepper=gere-com-openssl-rand-base64-48

# -----------------------------------------------------------------------------
# ⚠️  AS DUAS CHAVES ABAIXO NÃO TÊM RECUPERAÇÃO
# -----------------------------------------------------------------------------
#
# Elas cifram dados que já estão gravados no SEU banco. Perdê-las é perder o
# conteúdo cifrado — não existe suporte, backup nosso nem procedimento de
# resgate, porque a Congrega nunca teve as chaves.
#
# GUARDE UMA CÓPIA FORA DESTE SERVIDOR antes de subir a aplicação.
#
# São duas e não uma de propósito: têm ciclos de vida independentes. Rotacionar a
# de integrações porque um integrador viu o segredo não pode tornar ilegível a
# ficha de alergia de nenhuma criança.

# Cifra alergias, observações de saúde e a referência da foto das crianças.
ChildSafety__DataKey=gere-com-openssl-rand-base64-32

# Tempera do hash do código de retirada da criança (mínimo 32 caracteres).
ChildSafety__PickupCodePepper=gere-com-openssl-rand-base64-48

# Cifra as credenciais das integrações — senha do e-mail, token do bot, chave do
# Google. Perdida, basta reconfigurar as integrações na tela.
Connectors__DataKey=gere-com-openssl-rand-base64-32


# =============================================================================
# 3. CONGREGA+  — opcional
# =============================================================================
#
# Deixe em branco se você usa apenas o ChMS. O sistema funciona inteiro sem esta
# seção: membros, agenda, financeiro, cofre e integrações não dependem de
# assinatura. Só o catálogo de conteúdo — vídeos, eBooks e projetos, que ficam na
# infraestrutura da Congrega — exige uma licença ativa.
#
# A chave chega por e-mail quando a assinatura é confirmada.

Licensing__Key=

# Servidor de licenças da Congrega. Só mude se recebeu instrução para isso.
Licensing__CentralUrl=https://licenca.congrega.app

# Chave PÚBLICA que confere a assinatura da resposta do servidor de licenças.
# Já vem embutida na imagem; a variável existe para rotação sem republicar.
# Pública mesmo — não é segredo, e não serve para gerar licença nenhuma.
Licensing__PublicKeyPem=

# Quanto tempo a última confirmação continua valendo se o nosso servidor estiver
# fora do ar. Em dias. Existe para que uma queda nossa não deixe a sua igreja sem
# conteúdo num domingo de manhã.
Licensing__GraceWindow=7.00:00:00


# =============================================================================
# 4. OPERAÇÃO  — opcional, com padrões sensatos
# =============================================================================

# `Production` liga a exigência de um provedor de e-mail real e desliga os
# adaptadores de desenvolvimento. Deixe assim numa instalação de verdade.
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production

# Porta em que a API responde no host.
CONGREGA_API_PORT=5080

# Fuso usado para datas de negócio — a data do culto, o fechamento do mês.
Retention__BusinessTimeZone=America/Sao_Paulo

# O worker de retenção e o despachante do Outbox. Desligue apenas se estiver
# rodando um worker separado; com os dois ligados na mesma instalação, o lock
# distribuído impede o trabalho duplicado.
Outbox__Enabled=true
Retention__Enabled=true


# =============================================================================
# O QUE **NÃO** ESTÁ AQUI, E POR QUÊ
# =============================================================================
#
# `Payments__*` — a cobrança do Congrega+ acontece na infraestrutura da Congrega,
#   não na sua. Sua instalação nunca fala com o Abacate.pay, nunca recebe webhook
#   de pagamento e nunca guarda dado de cartão. Se você encontrar essas variáveis
#   num tutorial antigo, ignore: elas são do modelo hospedado, que foi
#   substituído.
#
# Credenciais de e-mail, Telegram ou Google Drive — não são configuradas por
#   aqui. Elas ficam na tela de Configurações, cifradas no seu banco com
#   `Connectors__DataKey`. Cada igreja tem as suas, e a tela é o lugar certo
#   porque a mesma instalação pode atender mais de uma congregação.
