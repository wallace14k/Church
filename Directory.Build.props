<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>

    <!-- Nullable reference types habilitado em toda a solution: exigência do briefing
         (Seção 7) e a defesa mais barata contra NullReferenceException em produção. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Warnings viram erro. Um aviso de nullability ignorado hoje é o incidente
         de amanhã; deixar o build passar com aviso é escolher acumular dívida. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

</Project>
