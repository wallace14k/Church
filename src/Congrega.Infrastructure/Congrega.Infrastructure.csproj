<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Congrega.Domain\Congrega.Domain.csproj" />
    <ProjectReference Include="..\Congrega.Application\Congrega.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <!-- Traz OptionsBuilder<T>.Bind(IConfiguration). Sem ele, .Bind() não resolve
         mesmo com o using de DependencyInjection presente. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      Os scripts DDL viajam DENTRO do assembly.

      A migration de baseline os executa em ordem. Embutir, em vez de ler do
      disco, garante que aplicar o schema em produção não dependa de a pasta
      `db/` ter sido copiada junto com o binário — o tipo de detalhe que só
      aparece no primeiro deploy, e no pior momento.

      O nome lógico é prefixado por número para deixar a ordem explícita: os
      arquivos são incrementais, e aplicar `002_members` antes de `schema`
      falharia por falta da tabela `tenants`.
    -->
    <EmbeddedResource Include="$(MSBuildProjectDirectory)/../../db/schema.sql"
                      LogicalName="Congrega.Db.010_schema.sql" />
    <EmbeddedResource Include="$(MSBuildProjectDirectory)/../../db/002_members.sql"
                      LogicalName="Congrega.Db.020_members.sql" />
    <EmbeddedResource Include="$(MSBuildProjectDirectory)/../../db/003_busca_sem_acento.sql"
                      LogicalName="Congrega.Db.030_busca.sql" />
    <EmbeddedResource Include="$(MSBuildProjectDirectory)/../../db/004_outbox_dead_letter.sql"
                      LogicalName="Congrega.Db.040_outbox.sql" />
    <!-- Fora do baseline de propósito: entra por migration própria, porque os
         bancos existentes já rodaram o baseline e não o executariam de novo. -->
    <EmbeddedResource Include="$(MSBuildProjectDirectory)/../../db/006_financeiro.sql"
                      LogicalName="Congrega.Db.060_financeiro.sql" />
    <EmbeddedResource Include="$(MSBuildProjectDirectory)/../../db/007_eventos.sql"
                      LogicalName="Congrega.Db.070_eventos.sql" />
    <EmbeddedResource Include="$(MSBuildProjectDirectory)/../../db/008_planos.sql"
                      LogicalName="Congrega.Db.080_planos.sql" />
    <EmbeddedResource Include="$(MSBuildProjectDirectory)/../../db/seed.sql"
                      LogicalName="Congrega.Db.900_seed.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- O teste de isolamento cross-tenant precisa do DbSet<Member> interno para
         provar, com IgnoreQueryFilters(), que o RLS segura o que o Global Query
         Filter deixaria passar. -->
    <InternalsVisibleTo Include="Congrega.Infrastructure.IntegrationTests" />
  </ItemGroup>

</Project>
