<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Congrega.Domain\Congrega.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Apenas abstrações. Logging.Abstractions e Options são contratos, não
      implementações — a aplicação declara que quer logar e ser configurada, sem
      saber que existe Serilog ou appsettings.json.

      Polly.Core é a exceção pragmática: envolvê-la em uma interface própria seria
      cerimônia sem ganho, e a skill dotnet-expert veda abstração sem benefício
      justificado. A dependência é de uma biblioteca de política, não de I/O.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Expõe membros internal para o projeto de testes.

      Usado para cobrir `OutboxProcessor.CalcularBackoff`, que é detalhe de
      implementação e não deve virar API pública só para ser testado — mas cujo
      comportamento (crescimento exponencial, jitter, teto) precisa de teste,
      porque errar ali produz rajada contra um provedor já instável.
    -->
    <InternalsVisibleTo Include="Congrega.Application.UnitTests" />
  </ItemGroup>

</Project>
