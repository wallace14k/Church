{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Npgsql": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },

  "Authentication": {
    "Issuer": "https://api.congrega.app",
    "Audience": "congrega-app",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "30.00:00:00",
    "//": "SigningKeyPem e OtpPepper NUNCA ficam aqui. Vem de Secret do Kubernetes:",
    "//_2": "Authentication__SigningKeyPem e Authentication__OtpPepper.",
    "//_3": "Gerar a chave: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048"
  },

  "Database": {
    "//": "Database__PooledConnectionString e Database__DirectConnectionString",
    "//_2": "vem de Secret. Ver ADR-006 sobre por que a API usa conexao direta."
  }
}
