{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "paths": {
      "@congrega/core/*": [
        "../../packages/core/src/*"
      ],
      "@congrega/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@congrega/api-client/*": [
        "../../packages/api-client/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
